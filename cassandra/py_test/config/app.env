# Application Configuration
# This file contains all application-specific configuration
# Includes K8s resource validation settings and Cassandra connection/authentication

# ==================== K8s Resource Configuration ====================
APP_NAMESPACE=default
APP_RESOURCE_TYPE=statefulset
APP_RESOURCE_NAME=cassandra
APP_LABEL_SELECTOR=app.kubernetes.io/instance=cassandra
APP_EXPECTED_REPLICAS=3

# ==================== Connection Configuration ====================
APP_PORT=9042
APP_SERVICE_NAME=cassandra-headless
# Enable automatic port-forwarding (set to false to use K8s DNS instead)
APP_ENABLE_PORT_FORWARD=true

# ==================== Authentication ====================
APP_USER=cassandra
APP_PASSWORD=cassandra
APP_AUTH_DATABASE=admin
APP_REPLICA_SET_NAME=0

# ==================== Cassandra Specific ====================
APP_KEYSPACE=system
APP_DATACENTER=dc1
APP_TEST_KEYSPACE=pytest_ks
APP_TEST_TABLE=pytest_table
