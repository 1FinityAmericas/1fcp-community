[localhost]
127.0.0.1

# ensure to have a sudo enabled user configured in all nodes
[localhost:vars]
ansible_connection=local
ansible_user=virtuora
ansible_group=virtuora
ansible_password='fnc123'
ansible_sudo_pass='fnc123'

# The number of master nodes can be either one or three.
# Plays will be adjusted according to the number of master nodes
# uncomment master2 & master3 for a multi-master HA cluster
[kubenodes]
kind-cluster-control-plane ip=172.19.0.5 host=kind-cluster-control-plane group='node-config-master'
kind-cluster-worker ip=172.19.0.4 host=kind-cluster-worker group='node-config-worker'
kind-cluster-worker2 ip=172.19.0.3 host=kind-cluster-worker2 group='node-config-worker'
kind-cluster-worker3 ip=172.19.0.2 host=kind-cluster-worker3 group='node-config-worker'

# ensure to have a sudo enabled user configured in all nodes
[kubenodes:vars]
ansible_ssh_private_key_file=./keyfile.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_connection=ssh
ansible_ssh_timeout=120
ansible_user=virtuora
ansible_group=virtuora
ansible_password='fnc123'
ansible_sudo_pass='fnc123'
stack_type='single'

# Explicit primary group for single-node kind cluster
[primary_master_node_group]
kind-cluster-control-plane

[all:vars]
ext_doc_reg_dns=artifactory.fnc.fujitsu.com
release_tag=fcp/1.0


