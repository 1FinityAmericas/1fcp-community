127.0.0.1

# ensure to have a sudo enabled kubenode user configured in all nodes
[localhost:vars]
ansible_connection=local
ansible_user=username
ansible_group=username
ansible_password='password'
ansible_sudo_pass='password'


[kubenodes]
master1 ip=xx.xxx.xxx.xx   host=master1  group='node-config-master'   ip6=2001:abc:0:224:1c1d:c468:7f54:867f
master2 ip=xx.xxx.xxx.xx   host=master2  group='node-config-master'  ip6=2001:abc:0:224::10
master3 ip=xx.xxx.xxx.xx   host=master3  group='node-config-master'  ip6=2001:abc:0:224::11
worker1 ip=xx.xxx.xxx.xx   host=worker1  group='node-config-compute'  ip6=2001:abc:0:224::12
worker2 ip=xx.xxx.xxx.xx   host=worker2  group='node-config-compute'  ip6=2001:abc:0:224::13
worker3 ip=xx.xxx.xxx.xx   host=worker3  group='node-config-compute'  ip6=2001:abc:0:224::13


# ensure to have a sudo enabled kubenode user configured in all nodes
[kubenodes:vars]
#ansible_ssh_private_key_file=./keyfile.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_connection=ssh
ansible_ssh_timeout=120
ansible_user=username
ansible_group=username
ansible_password='password'
ansible_sudo_pass='password'
stack_type='single'

