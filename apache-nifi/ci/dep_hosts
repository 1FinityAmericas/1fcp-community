[localhost]
127.0.0.1

# ensure to have a sudo enabled user configured in all nodes
[all:vars]
ansible_connection=local
ansible_user=virtuora
ansible_group=virtuora
ansible_password='fnc123'
ansible_sudo_pass='fnc123'

#-------------------------Local Registry Settings--------------------------------
#ext_doc_reg_dns='fnc.fujitsu.reg'
ext_doc_reg_dns='fnc.fujitsu.reg'

#-------------------------CICADA Version------------------------------------------------
#current release tag
release_tag=fcp/1.1

##=========================== ENVIRONMENT SETTINGS ============================
# k8s_provider: Determines kubernetes cluster type
#   - 'aks, eks, gke' : For AKS, EKS, GKE (no SSH to nodes, uses kubeconfig from jumpserver)
#   - 'rke2'    : For RKE2 clusters (SSH access to nodes)
k8s_provider='rke2'

#-------------------------Multi-master kube-vip Settings-------------------------
# change it to true if HA RKE2 is required with a VIP address
ha_rke2=false
# update this field with the respective network interface
ha_rke2_interface=ens3
# update  this field with a VIP address that is not assigned to any of the VMs in the network
ha_rke2_vip_address=10.156.183.100
# update the VIP address in the hostname
ha_rke2_vip_hostname=master.10.156.183.100.nip.io
#-----------------------------Ingress Host-------------------------------------
# Update the host for TLSingress
ingress_host=apache-nifi.10.156.185.86.nip.io


#-------------external_lb_setting---------------------------------------------
#chnage this to true if you are using the externla load balancer
external_lb=false
#update the external fqdn
external_fqdn=abc.xyz.com

# The number of master nodes can be either one or three.
# Plays will be adjusted according to the number of master nodes
# uncomment master2 & master3 for a multi-master HA cluster
[kubenodes]
master1 ip=10.156.185.86   host=master1  group='node-config-master'   ip6=2001:abc:0:224:1c1d:c468:7f54:867f
worker1 ip=10.156.185.87   host=worker1  group='node-config-compute'  ip6=2001:abc:0:224::12
worker2 ip=10.156.185.88   host=worker2  group='node-config-compute'  ip6=2001:abc:0:224::13
worker3 ip=10.156.185.89   host=worker3  group='node-config-compute'  ip6=2001:abc:0:224::14


# ensure to have a sudo enabled user configured in all nodes
[kubenodes:vars]
#ansible_ssh_private_key_file=./keyfile.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_connection=ssh
ansible_ssh_timeout=120
ansible_user=virtuora
ansible_group=virtuora
ansible_password='fnc123'
ansible_sudo_pass='fnc123'
stack_type='single'

