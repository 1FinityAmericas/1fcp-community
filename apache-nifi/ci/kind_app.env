# Application Configuration
# This file contains all application-specific configuration
# Includes K8s resource validation settings and Apache nifi connection/authentication

# ==================== K8s Resource Configuration ====================
APP_NAMESPACE=default
APP_RESOURCE_TYPE=statefulset
APP_RESOURCE_NAME=nifi
APP_LABEL_SELECTOR=app.kubernetes.io/instance=apache-nifi
APP_EXPECTED_REPLICAS=3

# ==================== Connection Configuration ====================
APP_PORT=8443
APP_SERVICE_NAME=nifi-headless
# Enable automatic port-forwarding (set to false to use K8s DNS instead)
APP_ENABLE_PORT_FORWARD=false
APP_PROTOCOL=https
APP_VERIFY_SSL=true
APP_AUTO_EXTRACT_CERT=true

# ==================== Authentication ====================
APP_USER=admin
APP_PASSWORD=0NifiAdmin@123
