[localhost]
127.0.0.1

# ensure to have a sudo enabled user configured in all nodes
[all:vars]
ansible_connection=local
ansible_user=username
ansible_group=username
ansible_password='password'
ansible_sudo_pass='password'

#-------------------------Local Registry Settings--------------------------------
ext_doc_reg_dns='docker.io'

#-------------------------CICADA Version------------------------------------------------
#current release tag
release_tag=fcp/1.1

##=========================== ENVIRONMENT SETTINGS ============================
# k8s_provider: Determines kubernetes cluster type
#   - 'aks, eks, gke' : For AKS, EKS, GKE (no SSH to nodes, uses kubeconfig from jumpserver)
#   - 'rke2'    : For RKE2 clusters (SSH access to nodes)
k8s_provider='rke2'

#-------------------------Multi-master kube-vip Settings-------------------------
# change it to true if HA RKE2 is required with a VIP address
ha_rke2=false
# update this field with the respective network interface
ha_rke2_interface=ens3
# update  this field with a VIP address that is not assigned to any of the VMs in the network
ha_rke2_vip_address=<kube_vip_ip>
# update the VIP address in the hostname
ha_rke2_vip_hostname=master.<kube_vip_ip>.nip.io
#-----------------------------Ingress Host-------------------------------------
# Update the host for TLSingress
ingress_host=apache-nifi.<master_ip>/<kube-vip-ip>.nip.io


#-------------external_lb_setting---------------------------------------------
#chnage this to true if you are using the externla load balancer
external_lb=false
#update the external fqdn
external_fqdn=abc.xyz.com

# The number of master nodes can be either one or three.
# Plays will be adjusted according to the number of master nodes
# Update xx.xxx.xxx.xx as per the cluster node IP details
[kubenodes]
master1 ip=xx.xxx.xxx.xx   host=master1  group='node-config-master'   ip6=2001:abc:0:224:1c1d:c468:7f54:867f
master2 ip=xx.xxx.xxx.xx   host=master2  group='node-config-master'  ip6=2001:abc:0:224::10
master3 ip=xx.xxx.xxx.xx   host=master3  group='node-config-master'  ip6=2001:abc:0:224::11
worker1 ip=xx.xxx.xxx.xx   host=worker1  group='node-config-compute'  ip6=2001:abc:0:224::12
worker2 ip=xx.xxx.xxx.xx   host=worker2  group='node-config-compute'  ip6=2001:abc:0:224::13
worker3 ip=xx.xxx.xxx.xx   host=worker3  group='node-config-compute'  ip6=2001:abc:0:224::13

# ensure to have a sudo enabled user configured in all nodes
[kubenodes:vars]
#ansible_ssh_private_key_file=./keyfile.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_connection=ssh
ansible_ssh_timeout=120
ansible_user=username
ansible_group=username
ansible_password='password'
ansible_sudo_pass='password'
stack_type='single'

