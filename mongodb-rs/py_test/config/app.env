# Application Configuration
# This file contains all application-specific configuration
# Includes K8s resource validation settings and MongoDB connection/authentication

# ==================== K8s Resource Configuration ====================
APP_NAMESPACE=database
APP_RESOURCE_TYPE=statefulset
APP_RESOURCE_NAME=mongodb-rs-rs0
APP_LABEL_SELECTOR=app=mongodb-rs
APP_EXPECTED_REPLICAS=3

# ==================== Connection Configuration ====================
APP_PORT=27017
APP_SERVICE_NAME=mongodb-rs-rs0
# Enable automatic port-forwarding (set to false to use K8s DNS instead)
APP_ENABLE_PORT_FORWARD=true
APP_WAIT_FOR_PODS_TIMEOUT=300

# ==================== Authentication ====================
APP_USER=databaseAdmin
APP_PASSWORD=databaseAdmin123456
APP_AUTH_DATABASE=admin
APP_REPLICA_SET_NAME=rs0
