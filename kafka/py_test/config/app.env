# Application Configuration
# This file contains all application-specific configuration
# Includes K8s resource validation settings and connection/authentication

# ==================== K8s Resource Configuration ====================
APP_NAMESPACE=ndl
APP_RESOURCE_TYPE=statefulset
APP_RESOURCE_NAME=kafka
APP_LABEL_SELECTOR=app=kafka
APP_EXPECTED_REPLICAS=3

# ==================== Connection Configuration ====================
APP_PORT=9092
APP_SERVICE_NAME=kafka-headless
# Enable automatic port-forwarding (set to false to use K8s DNS instead)
APP_ENABLE_PORT_FORWARD=false
APP_POD_READY_TIMEOUT=60
APP_KAFKA_CLIENT_POD=kafka-client
