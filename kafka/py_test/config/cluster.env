# Kubernetes Cluster Configuration
# This file contains K8s cluster-specific settings only
# Application-specific settings should go in app.env

# Kubernetes Configuration
KUBECONFIG=$HOME/.kube/config
K8S_TIMEOUT=120
K8S_API_TIMEOUT=30

# Proxy Configuration (disable proxy for k8s API and websocket connections)
NO_PROXY=*
no_proxy=*

# Container Runtime Configuration
#CTR_BIN_PATH=/var/lib/rancher/rke2/bin/ctr
CTR_BIN_PATH=/usr/bin/ctr
#CTR_SOCKET=/run/k3s/containerd/containerd.sock
CTR_SOCKET=/run/containerd/containerd.sock
CTR_NAMESPACE=k8s.io

# Test Configuration
TEST_DATA_PATH=tests/system

# Retry Configuration
RETRY_MAX_ATTEMPTS=10
RETRY_DELAY_SECONDS=5
