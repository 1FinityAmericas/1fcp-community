# ensure to have a sudo enabled user configured in all nodes
[localhost:vars]
ansible_connection=local
ansible_user=fnc123
ansible_group=fnc123
ansible_password='password'
ansible_sudo_pass='password'

[kubenodes]
master1 ip=10.156.183.94   host=master1  group='node-config-master'   ip6=2001:abc:0:224:1c1d:c468:7f54:867f
master2 ip=10.156.183.95   host=master2  group='node-config-master'  ip6=2001:abc:0:224::10
master3 ip=10.156.183.96   host=master3  group='node-config-master'  ip6=2001:abc:0:224::11
worker1 ip=10.156.183.97   host=worker1  group='node-config-compute'  ip6=2001:abc:0:224::12
worker2 ip=10.156.183.98   host=worker2  group='node-config-compute'  ip6=2001:abc:0:224::13
worker3 ip=10.156.183.99   host=worker3  group='node-config-compute'  ip6=2001:abc:0:224::13

# ensure to have a sudo enabled  user configured in all nodes
[kubenodes:vars]
#ansible_ssh_private_key_file=./keyfile.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_connection=ssh
ansible_ssh_timeout=120
ansible_user=fnc123
ansible_group=fnc123
ansible_password='password'
ansible_sudo_pass='password'
stack_type='single'

#-------------------------Local Registry Settings--------------------------------
# 'true' for deploying local registry
ext_docker_registry=true
ext_doc_reg_dns='fnc.fujitsu.reg'

# change it to true if HA RKE2 is required with a VIP address
ha_rke2=false
# update this field with the respective network interface
ha_rke2_interface=ens3
# update  this field with a VIP address that is not assigned to any of the VMs in the network
ha_rke2_vip_address=167.254.204.51
# update the VIP address in the hostname
ha_rke2_vip_hostname=master.167.254.204.51.nip.io
#-------------------------MVP Version------------------------------------------------
#current release tag
release_tag=fcp/1.0

#-------------external_lb_setting---------------------------------------------
#change this to true if you are using the external load balancer
external_lb=false
#update the external fqdn
external_fqdn=abc.xyz.com

[kubemasters]
master1
master2
master3

[kubeworkers]
worker1
worker2
worker3
